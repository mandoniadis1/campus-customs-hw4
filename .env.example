# Copy this file to hw4/.env and fill in your own values. Never commit the real .env.

# Required: Portkey API key (OpenAI-compatible gateway used by the chatbot agent)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: model for the chatbot (default: gpt-5.6)
CAMPUS_CUSTOMS_MODEL=gpt-5.6

# Optional: point the backend at a copy of the database (default: data/campus_customs.db)
# CAMPUS_CUSTOMS_DB=/absolute/path/to/campus_customs.db

# Optional: where the append-only audit trail is written (default: output/audit_trail.json)
# AUDIT_TRAIL_PATH=/absolute/path/to/audit_trail.json
